# Configuration Firebase des duels par Internet. Ces valeurs ne sont pas
# secrètes (elles sont lisibles dans l'application) : c'est le fichier
# database.rules.json, publié dans la console Firebase, qui protège la base.
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://sudokux-max-default-rtdb.europe-west1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sudokux-max
